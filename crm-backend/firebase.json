{
  "functions": {
    "source": ".",
    "runtime": "nodejs20",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "src",
      "prisma",
      "tsconfig.json",
      "*.md"
    ],
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run prisma:generate",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  }
}
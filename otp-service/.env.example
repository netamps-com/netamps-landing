# ==============================================================================
# SOC 2 SECURE ENVIRONMENT CONFIGURATION
# ==============================================================================
# WARNING: Do NOT commit the actual `.env` file to version control.
# Only commit this `.env.example` file.

# Node Environment
NODE_ENV=production

# ==============================================================================
# INFRASTRUCTURE CONNECTION STRINGS (TLS ENFORCED)
# ==============================================================================
# Redis Ephemeral Store (Use `rediss://` for strict TLS if external, otherwise local bridge `redis://`)
REDIS_URL=redis://:secure_redis_password@cache:6379/0

# PostgreSQL Audit Database
DATABASE_URL=postgresql://audit_user:secure_pg_password@audit_db:5432/audit_logs

# ==============================================================================
# SMTP MAIL TRANSFER AGENT (MTA) CONFIGURATION
# ==============================================================================
# Requires strict TLS/SSL. Port 465 forces implicit TLS.
SMTP_HOST=smtp.your-foss-mta.example.com
SMTP_PORT=465
SMTP_USER=secure_smtp_user
SMTP_PASS=SuperStrongSMTPPassword123!
SMTP_FROM=security@example.com

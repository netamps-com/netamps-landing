# ---- Runtime ----
NODE_ENV=production
PORT=8080
TRUST_PROXY=1
# Comma-separated allowed origins for CORS (no wildcard in production)
CORS_ORIGINS=https://www.netamps.com,https://netamps-landing.pages.dev

# ---- Database (PostgreSQL — inject via Secret Manager in production) ----
DATABASE_URL=postgresql://netamps:CHANGE_ME@localhost:5432/netamps_crm?schema=public

# ---- Auth (RS256 PEM, base64-encoded; generate with `npm run genkeys`) ----
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
JWT_ACCESS_TTL_SEC=900

# ---- PII column encryption (AES-256-GCM, base64 32 bytes; generate with `npm run genkeys`) ----
DATA_ENCRYPTION_KEY_B64=

# ---- Email (Resend; DKIM/SPF verified domain required) ----
RESEND_API_KEY=
MAIL_FROM_NAME=Netamps Portal
MAIL_FROM_EMAIL=no-reply@netamps.in

# ---- Queue (optional — email sends inline when absent) ----
REDIS_URL=

# ---- TLS (container usually sits behind LB that terminates TLS; set these only for direct exposure) ----
TLS_KEY_PEM_B64=
TLS_CERT_PEM_B64=
ENFORCE_TLS13_DIRECT=1

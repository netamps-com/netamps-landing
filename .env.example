# Production Login URL
# This should point to your production login/staff portal
NEXT_PUBLIC_LOGIN_URL=https://netamps.com/login

# Production Return Portal URL
# This should point to your production ITAD/return portal
NEXT_PUBLIC_RETURN_PORTAL_URL=https://returns.netamps.com

# Cloudflare Turnstile (bot protection for Login & Returns forms)
# Get the site key from Cloudflare Dashboard → Turnstile → Add site
# Without this key, forms fall back to unprotected submit (dev only)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret (SERVER-SIDE ONLY — never commit, never prefix with NEXT_PUBLIC_)
# Set as a secret in Cloudflare Pages → Settings → Environment variables
# Used by functions/api/verify-turnstile.js to validate tokens
TURNSTILE_SECRET_KEY=

# Dashboard session signing key (SERVER-SIDE ONLY)
# Signs the session_id cookie (token.exp.sig) so forged admin cookies fail
# closed in verifySession. REQUIRED in production; while unset, legacy
# unsigned cookies are accepted (dev only) and admin forgery is possible.
DEMO_SESSION_SECRET=

# Resend webhook signing secret (SERVER-SIDE ONLY)
# From Resend → Webhooks → Signing Secret (whsec_…). Verifies Svix signatures
# on /api/email/events (bounce/complaint/delivered). REQUIRED in production;
# while unset, events are accepted but only logged, never applied.
EMAIL_WEBHOOK_SECRET=

# Internal testing gate for *.pages.dev (SERVER-SIDE ONLY, ASCII-only)
# Set as a secret in Cloudflare Pages → Settings → Environment variables.
# When set, the pages.dev URL requires HTTP Basic Auth (user: netamps).
# Production (netamps.com) is never gated. Leave unset to allow open dev access.
DEV_GATE_PASSWORD=
